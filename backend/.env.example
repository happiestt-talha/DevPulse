# .env.example – copy to .env and fill in real values
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devpulse
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=your-super-secret-jwt-secret-change-me
ENCRYPTION_KEY=your-fernet-key-base64-url-safe-32-bytes-

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

WAKATIME_CLIENT_ID=your_wakatime_oauth_client_id
WAKATIME_CLIENT_SECRET=your_wakatime_oauth_secret
WAKATIME_REDIRECT_URI=http://localhost:8000/api/v1/auth/wakatime/callback   # or your custom callback